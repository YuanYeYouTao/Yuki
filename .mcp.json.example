{
  "mcpServers": {
    "netease_music": {
      "url": "http://host.docker.internal:8766/mcp",
      "lifecycle": "keep_alive",
      "disabled": true,
      "connectTimeoutSeconds": 10,
      "requestTimeoutSeconds": 30,
      "reconnectDelaySeconds": 5,
      "includeTools": [
        "music_search",
        "get_recommendations",
        "get_similar_songs",
        "get_new_songs",
        "get_rankings",
        "get_songs",
        "get_album",
        "get_artist",
        "get_playlist",
        "get_lyrics",
        "get_user_library",
        "get_playlist_statistics"
      ],
      "yuki": {
        "scope": "mcp.netease_music",
        "summary": "网易云音乐的搜索、推荐、相似歌曲、新歌、榜单、资料、歌词和用户音乐库只读查询",
        "tags": ["音乐", "网易云", "搜索", "推荐", "新歌", "榜单", "歌曲", "歌手", "专辑", "歌单", "歌词"],
        "toolAnnotations": {
          "music_search": {"readOnlyHint": true, "idempotentHint": true},
          "get_recommendations": {"readOnlyHint": true, "idempotentHint": true},
          "get_similar_songs": {"readOnlyHint": true, "idempotentHint": true},
          "get_new_songs": {"readOnlyHint": true, "idempotentHint": true},
          "get_rankings": {"readOnlyHint": true, "idempotentHint": true},
          "get_songs": {"readOnlyHint": true, "idempotentHint": true},
          "get_album": {"readOnlyHint": true, "idempotentHint": true},
          "get_artist": {"readOnlyHint": true, "idempotentHint": true},
          "get_playlist": {"readOnlyHint": true, "idempotentHint": true},
          "get_lyrics": {"readOnlyHint": true, "idempotentHint": true},
          "get_user_library": {"readOnlyHint": true, "idempotentHint": true},
          "get_playlist_statistics": {"readOnlyHint": true, "idempotentHint": true}
        }
      }
    },
    "miniflux": {
      "url": "http://miniflux-mcp:8080/mcp",
      "headers": {
        "Authorization": "Bearer ${MINIFLUX_MCP_TOKEN}"
      },
      "lifecycle": "keep_alive",
      "disabled": true,
      "connectTimeoutSeconds": 10,
      "requestTimeoutSeconds": 60,
      "reconnectDelaySeconds": 5,
      "includeTools": [
        "create_feed",
        "delete_feed",
        "get_feed",
        "get_feeds",
        "update_feed",
        "refresh_feed",
        "refresh_all_feeds",
        "get_feed_entries",
        "get_feed_entry",
        "get_feed_icon",
        "mark_feed_as_read",
        "get_entries",
        "get_entry",
        "update_entry_status",
        "toggle_starred",
        "save_entry",
        "fetch_original_content",
        "mark_all_as_read",
        "get_enclosure",
        "get_icon",
        "create_category",
        "delete_category",
        "get_categories",
        "update_category",
        "get_category_feeds",
        "get_category_entries",
        "get_category_entry",
        "mark_category_as_read",
        "refresh_category",
        "discover",
        "fetch_counters",
        "get_version",
        "healthcheck"
      ],
      "yuki": {
        "scope": "mcp.miniflux",
        "summary": "管理 RSS 订阅源和分类，阅读、收藏、保存与更新 Miniflux 文章状态",
        "tags": ["RSS", "订阅", "订阅源", "文章", "未读", "阅读器", "Miniflux"],
        "toolBundles": {
          "subscriptions": {
            "scope": "mcp.miniflux.subscriptions",
            "summary": "发现、添加、删除、修改、刷新和查看 RSS 订阅源",
            "includeTools": [
              "create_feed",
              "delete_feed",
              "get_feed",
              "get_feeds",
              "update_feed",
              "refresh_feed",
              "refresh_all_feeds",
              "get_feed_entries",
              "get_feed_entry",
              "get_feed_icon",
              "mark_feed_as_read",
              "discover",
              "fetch_counters"
            ]
          },
          "articles": {
            "scope": "mcp.miniflux.articles",
            "summary": "查询 RSS 文章，获取正文和附件，并更新已读、收藏与保存状态",
            "includeTools": [
              "get_entries",
              "get_entry",
              "update_entry_status",
              "toggle_starred",
              "save_entry",
              "fetch_original_content",
              "mark_all_as_read",
              "get_enclosure",
              "get_icon"
            ]
          },
          "categories": {
            "scope": "mcp.miniflux.categories",
            "summary": "创建、删除、修改和查看 RSS 分类及分类文章",
            "includeTools": [
              "create_category",
              "delete_category",
              "get_categories",
              "update_category",
              "get_category_feeds",
              "get_category_entries",
              "get_category_entry",
              "mark_category_as_read",
              "refresh_category"
            ]
          }
        },
        "automation": {
          "enabled": true,
          "permission": "user",
          "includeTools": [
            "get_feed",
            "get_feeds",
            "get_feed_entries",
            "get_feed_entry",
            "get_entries",
            "get_entry",
            "fetch_original_content",
            "get_categories",
            "get_category_feeds",
            "get_category_entries",
            "get_category_entry",
            "fetch_counters",
            "get_version",
            "healthcheck"
          ]
        },
        "toolAnnotations": {
          "get_feed": {"readOnlyHint": true, "idempotentHint": true},
          "get_feeds": {"readOnlyHint": true, "idempotentHint": true},
          "get_feed_entries": {"readOnlyHint": true, "idempotentHint": true},
          "get_feed_entry": {"readOnlyHint": true, "idempotentHint": true},
          "get_feed_icon": {"readOnlyHint": true, "idempotentHint": true},
          "get_entries": {"readOnlyHint": true, "idempotentHint": true},
          "get_entry": {"readOnlyHint": true, "idempotentHint": true},
          "fetch_original_content": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
          "get_enclosure": {"readOnlyHint": true, "idempotentHint": true},
          "get_icon": {"readOnlyHint": true, "idempotentHint": true},
          "get_categories": {"readOnlyHint": true, "idempotentHint": true},
          "get_category_feeds": {"readOnlyHint": true, "idempotentHint": true},
          "get_category_entries": {"readOnlyHint": true, "idempotentHint": true},
          "get_category_entry": {"readOnlyHint": true, "idempotentHint": true},
          "discover": {"readOnlyHint": true, "idempotentHint": true, "openWorldHint": true},
          "fetch_counters": {"readOnlyHint": true, "idempotentHint": true},
          "get_version": {"readOnlyHint": true, "idempotentHint": true},
          "healthcheck": {"readOnlyHint": true, "idempotentHint": true},
          "delete_feed": {"destructiveHint": true},
          "delete_category": {"destructiveHint": true}
        }
      }
    }
  }
}
