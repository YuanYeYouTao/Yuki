[Unit]
Description=Yuki Bocchi QQ agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yuki
Group=yuki
WorkingDirectory=/home/yuki/app
EnvironmentFile=/home/yuki/app/.env
ExecStart=/home/yuki/app/.venv/bin/qq-ai-bot
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
