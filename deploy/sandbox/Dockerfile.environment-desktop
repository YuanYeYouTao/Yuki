# Optional capabilities over the same persistent execution environment.
ARG BASE_IMAGE=yuki-environment:local
FROM ${BASE_IMAGE}
USER root
ARG BROWSER_MODE=headed
ARG EXTRA_PACKAGES=""
COPY deploy/sandbox/install-programs.sh /opt/yuki-runtime/install-programs.sh
COPY deploy/sandbox/desktop-manifest.py /opt/yuki-runtime/desktop-manifest.py
COPY deploy/sandbox/yuki-computer.sh /usr/local/bin/yuki-computer
RUN set -f; /bin/sh /opt/yuki-runtime/install-programs.sh "$BROWSER_MODE" $EXTRA_PACKAGES
COPY src/yuki/sandbox/yuki_computer.py /opt/yuki-runtime/yuki_computer.py
COPY packages/yuki-agent-connector/src/yuki_agent_connector/cdp.py /opt/yuki-runtime/yuki_agent_connector/cdp.py
COPY src/yuki/sandbox/desktop_service.py /opt/yuki-runtime/desktop_service.py
