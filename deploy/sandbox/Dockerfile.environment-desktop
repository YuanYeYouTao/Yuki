# The browser and desktop over the base environment. Published as the "-desktop" image;
# the headless and desktop profiles both use it and choose the mode at run time.
ARG BASE_IMAGE=yuki-environment:local
FROM ${BASE_IMAGE}
USER root
COPY src/yuki/sandbox/environment_programs.py /tmp/environment_programs.py
RUN python /tmp/environment_programs.py headed && rm /tmp/environment_programs.py
