# Settings for this Manager host. MiB values and package selection are editable.
YUKI_SANDBOX_IMAGE=yuki-environment:my-machine
YUKI_SANDBOX_BROWSER_MODE=headed
YUKI_SANDBOX_PACKAGES="tree"
YUKI_SANDBOX_CPUS=2
YUKI_SANDBOX_MEMORY_MIB=3072
YUKI_SANDBOX_SWAP_MIB=512
YUKI_SANDBOX_PIDS=2048
YUKI_SANDBOX_TMP_MIB=512
YUKI_SANDBOX_SHM_MIB=256
YUKI_SANDBOX_HOME_MIB=8192
YUKI_SANDBOX_RUNTIME_MIB=256
