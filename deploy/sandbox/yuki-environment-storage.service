[Unit]
Description=Yuki persistent home with 16 GiB initial filesystem capacity
Before=yuki-sandbox.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh /opt/yuki-sandbox/deploy/sandbox/environment-storage.sh
# Do not unmount on Manager restart: the environment retains open files/processes.

[Install]
WantedBy=multi-user.target
