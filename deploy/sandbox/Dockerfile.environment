# syntax=docker/dockerfile:1.7
FROM golang:1.25.9 AS execd
ARG OPENSANDBOX_COMMIT=441042c288a3eacbe93b36236a9baf6f6254ad4d
ADD https://codeload.github.com/opensandbox-group/OpenSandbox/tar.gz/${OPENSANDBOX_COMMIT} /tmp/source.tar.gz
RUN mkdir /source && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /source
WORKDIR /source/components/execd
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' -o /execd ./main.go

FROM node:22-bookworm-slim AS node
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash git curl jq ripgrep zip unzip tar gzip ca-certificates build-essential procps \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 yuki && useradd --uid 10001 --gid yuki --home-dir /home/yuki yuki
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s /home/yuki/workspace /workspace \
    && ln -s /home/yuki/work /work && ln -s /home/yuki/inputs /inputs
RUN pip install --no-cache-dir Pillow openpyxl pypdf
COPY --from=execd /execd /opt/opensandbox/execd
COPY --from=execd /source/LICENSE /usr/share/licenses/opensandbox/LICENSE
COPY src/qq_ai_bot/sandbox/environment_supervisor.py /opt/yuki-runtime/supervisor.py
ENV HOME=/home/yuki \
    PYTHONUSERBASE=/home/yuki/.local \
    PATH=/home/yuki/.local/bin:/usr/local/bin:/usr/bin:/bin \
    NPM_CONFIG_PREFIX=/home/yuki/.local \
    PIP_CACHE_DIR=/home/yuki/.cache/pip \
    NO_PROXY=localhost,127.0.0.1,::1 \
    no_proxy=localhost,127.0.0.1,::1 \
    PYTHONUNBUFFERED=1
LABEL io.yuki.environment.source="OpenSandbox@441042c288a3eacbe93b36236a9baf6f6254ad4d"
USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["/opt/opensandbox/execd"]
CMD ["--port=44772", "--log-level=4"]
