# syntax=docker/dockerfile:1.7
FROM golang:1.25.9 AS execd
ARG OPENSANDBOX_COMMIT=441042c288a3eacbe93b36236a9baf6f6254ad4d
ADD https://codeload.github.com/opensandbox-group/OpenSandbox/tar.gz/${OPENSANDBOX_COMMIT} /tmp/source.tar.gz
RUN mkdir /source && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /source
WORKDIR /source/components/execd
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' -o /execd ./main.go

FROM ghcr.io/astral-sh/uv:0.11.31 AS uv
FROM python:3.12-slim-bookworm AS yuki-client
COPY --from=uv /uv /bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/yuki-client UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /build
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable
COPY deploy/sandbox/client-manifest.py /opt/yuki-client/verify-installation.py
ARG VCS_REF=unknown
RUN /opt/yuki-client/bin/python /opt/yuki-client/verify-installation.py /build/uv.lock "$VCS_REF"

FROM node:22-bookworm-slim AS node
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash git curl jq ripgrep zip unzip tar gzip ca-certificates build-essential procps \
    tigervnc-standalone-server openbox chromium socat fonts-noto-cjk fonts-noto-color-emoji \
    xdotool x11-utils imagemagick \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 yuki && useradd --uid 10001 --gid yuki --home-dir /home/yuki yuki
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s /home/yuki/workspace /workspace \
    && ln -s /home/yuki/work /work && ln -s /home/yuki/inputs /inputs
RUN pip install --no-cache-dir Pillow openpyxl pypdf agent-client-protocol==0.12.1 websockets==15.0.1
COPY --from=yuki-client /opt/yuki-client /opt/yuki-client
COPY --from=execd /execd /opt/opensandbox/execd
COPY --from=execd /source/LICENSE /usr/share/licenses/opensandbox/LICENSE
COPY src/yuki/sandbox/environment_supervisor.py /opt/yuki-runtime/supervisor.py
COPY src/yuki/sandbox/acp_peer.py /opt/yuki-runtime/acp_peer.py
COPY src/yuki/sandbox/yuki_computer.py /opt/yuki-runtime/yuki_computer.py
COPY src/yuki/sandbox/desktop_service.py /opt/yuki-runtime/desktop_service.py
COPY deploy/sandbox/desktop-manifest.py /opt/yuki-runtime/desktop-manifest.py
COPY deploy/sandbox/yuki-computer.sh /usr/local/bin/yuki-computer
RUN chmod 755 /usr/local/bin/yuki-computer \
    && python /opt/yuki-runtime/desktop-manifest.py
COPY src/yuki/emoji/sticker_index.py /opt/yuki-runtime/sticker_index.py
COPY src/yuki/emoji/media.py /opt/yuki-runtime/media.py
ENV HOME=/home/yuki \
    USER=root \
    LOGNAME=root \
    PYTHONUSERBASE=/home/yuki/.local \
    PATH=/home/yuki/.local/bin:/usr/local/bin:/usr/bin:/bin \
    NPM_CONFIG_PREFIX=/home/yuki/.local \
    PIP_CACHE_DIR=/home/yuki/.cache/pip \
    NO_PROXY=localhost,127.0.0.1,::1 \
    no_proxy=localhost,127.0.0.1,::1 \
    PYTHONUNBUFFERED=1
LABEL io.yuki.environment.source="OpenSandbox@441042c288a3eacbe93b36236a9baf6f6254ad4d"
USER 0:0
WORKDIR /workspace
ENTRYPOINT ["/opt/opensandbox/execd"]
CMD ["--port=44772", "--log-level=4"]
